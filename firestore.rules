rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function esDueno(uid)   { return autenticado() && request.auth.uid == uid; }
    // Google ya verifica el email; las cuentas con email y contraseña, al tocar el link.
    function verificado()   { return request.auth.token.email_verified == true; }

    // Versión guardada de una propuesta o un portfolio ({coleccion}/{id}/versiones/{versionId}).
    // Solo la crea y la lee el dueño del documento; no se edita: se crea o se borra.
    function versionValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'payload', 'title', 'motivo', 'createdAt'])
        && d.userId == request.auth.uid
        && d.payload is map
        && d.title is string && d.title.size() <= 200
        && d.motivo in ['manual', 'enviada', 'antes-de-restaurar']
        && d.createdAt == request.time;
    }

    match /users/{uid} {
      function texto(m, campo, largo) { return m.get(campo, '') is string && m.get(campo, '').size() <= largo; }

      // Datos del negocio que se usan por defecto en las propuestas nuevas.
      function emisorValido(e) {
        return e is map
          && e.keys().hasOnly(['nombre', 'rol', 'email', 'telefono', 'web', 'presentacion', 'logo', 'foto', 'ubicacion', 'instagram', 'linkedin', 'behance', 'github'])
          && texto(e, 'nombre', 200) && texto(e, 'rol', 200) && texto(e, 'email', 200)
          && texto(e, 'telefono', 200) && texto(e, 'web', 200) && texto(e, 'presentacion', 2000)
          && texto(e, 'ubicacion', 200) && texto(e, 'instagram', 200) && texto(e, 'linkedin', 200)
          && texto(e, 'behance', 200) && texto(e, 'github', 200)
          // El logo y la foto solo pueden ser archivos del Storage de Dealit.
          && texto(e, 'logo', 1000)
          && (e.get('logo', '') == '' || e.get('logo', '').matches('https://firebasestorage[.]googleapis[.]com/v0/b/dealit-7f735[.]firebasestorage[.]app/o/.*'))
          && texto(e, 'foto', 1000)
          && (e.get('foto', '') == '' || e.get('foto', '').matches('https://firebasestorage[.]googleapis[.]com/v0/b/dealit-7f735[.]firebasestorage[.]app/o/.*'));
      }

      allow read: if esDueno(uid);
      allow create, update: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt', 'emisor'])
        && request.resource.data.email == request.auth.token.email
        && texto(request.resource.data, 'displayName', 80)
        && (!('emisor' in request.resource.data) || emisorValido(request.resource.data.emisor));
      allow delete: if esDueno(uid);
    }

    match /proposals/{proposalId} {
      // Visitas, aceptación, primer envío y marca de Dealit: solo los escribe el servidor
      // (api/visto, api/aceptar, api/activar).
      function camposDelServidor() { return ['vistas', 'vistoPrimero', 'vistoUltimo', 'aceptacion', 'enviadaEn', 'marca']; }

      // Activar el link pasa por api/activar, que aplica el límite del plan. El navegador
      // solo puede desactivarlo.
      function noActivaElLink() {
        return request.resource.data.get('publico', false) != true
          || (resource != null && resource.data.get('publico', false) == true);
      }

      function datosValidos() {
        let d = request.resource.data;
        return d.keys().hasOnly(['userId', 'title', 'clientName', 'amount', 'status',
                                 'theme', 'payload', 'publico', 'createdAt', 'updatedAt',
                                 'vistas', 'vistoPrimero', 'vistoUltimo', 'aceptacion', 'enviadaEn', 'marca'])
          && d.title is string      && d.title.size() <= 200
          && d.clientName is string && d.clientName.size() <= 200
          && d.amount is number
          && d.theme is string
          && d.payload is map
          && d.status in ['draft', 'sent', 'accepted', 'rejected']
          && d.get('publico', false) is bool
          && d.updatedAt == request.time;
      }

      // get = abrir una sola por ID (link del cliente); list = consultas del panel
      allow get:  if esDueno(resource.data.userId)
                  || resource.data.get('publico', false) == true;
      allow list: if esDueno(resource.data.userId);

      allow create: if esDueno(request.resource.data.userId)
        && verificado()
        && datosValidos()
        && !request.resource.data.keys().hasAny(camposDelServidor())
        && request.resource.data.get('publico', false) != true
        && request.resource.data.createdAt == request.time;

      allow update: if esDueno(resource.data.userId)
        && verificado()
        && request.resource.data.userId    == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDelServidor())
        && noActivaElLink()
        && datosValidos();

      allow delete: if esDueno(resource.data.userId);

      match /versiones/{versionId} {
        function duenoDeLaPropuesta() {
          return autenticado() && get(/databases/$(database)/documents/proposals/$(proposalId)).data.userId == request.auth.uid;
        }
        allow read:   if duenoDeLaPropuesta();
        allow create: if duenoDeLaPropuesta() && verificado() && versionValida();
        // Se puede borrar aunque la propuesta ya no exista.
        allow delete: if esDueno(resource.data.userId);
      }
    }


    match /portfolios/{portfolioId} {
      function datosPortafolioValidos() {
        let d = request.resource.data;
        return d.keys().hasOnly(['userId', 'title', 'subtitle', 'projectCount',
                                 'theme', 'payload', 'publico', 'createdAt', 'updatedAt',
                                 'vistas', 'vistoPrimero', 'vistoUltimo'])
          && d.title is string        && d.title.size() <= 200
          && d.get('subtitle', '') is string && d.get('subtitle', '').size() <= 200
          && d.get('projectCount', 0) is number
          && d.theme is string
          && d.payload is map
          && d.get('publico', false) is bool
          && d.updatedAt == request.time;
      }

      allow get:  if esDueno(resource.data.userId)
                  || resource.data.get('publico', false) == true;
      allow list: if esDueno(resource.data.userId);

      allow create: if esDueno(request.resource.data.userId)
        && verificado()
        && datosPortafolioValidos()
        && request.resource.data.createdAt == request.time;

      allow update: if esDueno(resource.data.userId)
        && verificado()
        && request.resource.data.userId    == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && datosPortafolioValidos();

      allow delete: if esDueno(resource.data.userId);

      match /versiones/{versionId} {
        function duenoDelPortafolio() {
          return autenticado() && get(/databases/$(database)/documents/portfolios/$(portfolioId)).data.userId == request.auth.uid;
        }
        allow read:   if duenoDelPortafolio();
        allow create: if duenoDelPortafolio() && verificado() && versionValida();
        allow delete: if esDueno(resource.data.userId);
      }
    }

    // Plan de cada usuario (Gratis / Pro) y envíos del mes: lo escriben solo
    // api/activar y api/mercadopago. El dueño lo lee para ver su estado.
    match /planes/{uid} {
      allow read: if esDueno(uid);
      allow write: if false;
    }

    // Datos para cobrar por transferencia (titular, CBU/CVU, alias): uno por cuenta, aparte
    // de las propuestas (que se pueden leer con el link). Solo los lee y escribe el dueño;
    // el cliente los recibe del servidor (api/aceptar) recién al aceptar.
    match /cobros/{uid} {
      function cobroValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['titular', 'cbu', 'alias', 'actualizado'])
          && d.titular is string && d.titular.size() <= 120
          && d.cbu is string && d.cbu.size() <= 40
          && d.alias is string && d.alias.size() <= 40
          && d.actualizado == request.time;
      }
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && verificado() && cobroValido();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
