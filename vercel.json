{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://dealit-7f735.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://dealit-7f735.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "dealit_app"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "verificado"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "ingresar"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "propuesta"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "portafolio"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "seccion"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "destination": "/inicio.html"
    },
    {
      "source": "/empezar",
      "destination": "/app.html"
    },
    {
      "source": "/ingresar",
      "destination": "/app.html"
    },
    {
      "source": "/accion",
      "destination": "/app.html"
    },
    {
      "source": "/plantillas",
      "destination": "/app.html"
    },
    {
      "source": "/portafolios",
      "destination": "/app.html"
    },
    {
      "source": "/cuenta",
      "destination": "/app.html"
    },
    {
      "source": "/resultados",
      "destination": "/app.html"
    },
    {
      "source": "/propuesta/:id",
      "destination": "/app.html"
    },
    {
      "source": "/editar-portafolio/:id",
      "destination": "/app.html"
    },
    {
      "source": "/p/:id",
      "destination": "/app.html"
    },
    {
      "source": "/portafolio/:id",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/ia-propuesta.js": {
      "maxDuration": 60
    }
  }
}
