{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://dealit-7f735.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://dealit-7f735.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/p/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Applebot|redditbot|vkShare|Viber|Embedly|Iframely|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/vista-previa?tipo=propuesta&id=:id"
    },
    {
      "source": "/portafolio/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterest|SkypeUriPreview|Applebot|redditbot|vkShare|Viber|Embedly|Iframely|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/vista-previa?tipo=portafolio&id=:id"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "dealit_sesion"
        }
      ],
      "destination": "/app"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "verificado"
        }
      ],
      "destination": "/app"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "ingresar"
        }
      ],
      "destination": "/app"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "propuesta"
        }
      ],
      "destination": "/app"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "portafolio"
        }
      ],
      "destination": "/app"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "seccion"
        }
      ],
      "destination": "/app"
    },
    {
      "source": "/",
      "destination": "/inicio"
    },
    {
      "source": "/instalar",
      "destination": "/inicio"
    },
    {
      "source": "/empezar",
      "destination": "/app"
    },
    {
      "source": "/ingresar",
      "destination": "/app"
    },
    {
      "source": "/accion",
      "destination": "/app"
    },
    {
      "source": "/plantillas",
      "destination": "/app"
    },
    {
      "source": "/clientes",
      "destination": "/app"
    },
    {
      "source": "/portafolios",
      "destination": "/app"
    },
    {
      "source": "/cuenta",
      "destination": "/app"
    },
    {
      "source": "/resultados",
      "destination": "/app"
    },
    {
      "source": "/propuesta/:id",
      "destination": "/app"
    },
    {
      "source": "/editar-portafolio/:id",
      "destination": "/app"
    },
    {
      "source": "/p/:id",
      "destination": "/app"
    },
    {
      "source": "/portafolio/:id",
      "destination": "/app"
    }
  ],
  "crons": [
    {
      "path": "/api/visto",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/ia-propuesta.js": {
      "maxDuration": 60
    }
  }
}
