{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://dealit-7f735.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://dealit-7f735.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/portafolios",
      "destination": "/"
    },
    {
      "source": "/cuenta",
      "destination": "/"
    },
    {
      "source": "/propuesta/:id",
      "destination": "/"
    },
    {
      "source": "/editar-portafolio/:id",
      "destination": "/"
    },
    {
      "source": "/p/:id",
      "destination": "/"
    },
    {
      "source": "/portafolio/:id",
      "destination": "/"
    }
  ]
}
