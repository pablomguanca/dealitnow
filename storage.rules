rules_version = '2';

// Reglas de Firebase Storage para el generador de propuestas.
// Subilas desde la consola de Firebase → Storage → Reglas (o con `firebase deploy --only storage`).
service firebase.storage {
  match /b/{bucket}/o {

    // Logos e imágenes de portada/proyectos: cada usuario sube en su carpeta; cualquiera con el link puede verlos
    // (las propuestas compartidas los muestran sin pedir sesión).
    match /logos/{uid}/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    match /{resto=**} {
      allow read, write: if false;
    }
  }
}
