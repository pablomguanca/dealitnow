rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Logos: cada usuario solo escribe en su carpeta, solo imágenes rasterizadas
    // y con nombre = hash SHA-256 del contenido. Los clientes ven el logo con la
    // URL de descarga (lleva un token), que no depende de estas reglas.
    match /users/{uid}/logos/{archivo} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && archivo.matches('[a-f0-9]{64}[.](png|jpg|webp)')
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
